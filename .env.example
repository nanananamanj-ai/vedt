# Copy to .env and fill in from your Supabase project dashboard.
# Project ID is shown under Project Settings → General.
#
# IMPORTANT: only the *publishable* key belongs here. It is safe in client
# bundles and is meant to be public. NEVER put an `sb_secret_` key in this
# file — a secret key grants full bypass of Row Level Security, and the
# VITE_-prefixed copies below are injected into browser-visible code.

SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# VITE_ copies are exposed to the browser. Same publishable key.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
